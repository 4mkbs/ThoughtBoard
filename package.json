{
  "name": "ThoughtBoard",
  "private": true,
  "version": "0.1.1",
  "description": "ThoughtBoard - A local offline shared notepad",
  "author": {
    "name": "4mkbs",
    "email": "4mkbs@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/4mkbs/ThoughtBoard",
  "repository": {
    "type": "git",
    "url": "https://github.com/4mkbs/ThoughtBoard.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "tsc && vite build && electron-builder",
    "dist": "tsc && vite build && electron-builder --publish never",
    "preview": "vite preview",
    "dev:web": "vite --mode web",
    "build:web": "tsc && vite build --mode web"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
